{
  "name": "@eduksx/ui",
  "version": "0.1.0",
  "description": "Design-System der EduKSX-Plattform: Design-Tokens, Kontrastprüfung und React-Bausteine.",
  "license": "MIT",
  "author": "Markus Keller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarkusKeller8200/EduKSX-UI.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tokens",
    "icons/svg",
    "icons/png"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./eduksx.css": "./dist/eduksx.css",
    "./tokens.json": "./tokens/tokens.json",
    "./icons/*": "./icons/*"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && vite build && tsc -p tsconfig.build.json",
    "typecheck": "npm run tokens && tsc --noEmit",
    "test": "npm run tokens && vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
